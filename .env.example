# Atelier - cles API OPTIONNELLES
# Copier ce fichier en .env et remplir ce qui est utile.
#
# NOTE: Si vous utilisez Claude Code avec votre abonnement Claude Pro,
# vous n'avez PAS besoin de ANTHROPIC_API_KEY ici. L'authentification se fait
# via `claude login` qui ouvre le navigateur pour une connexion OAuth avec
# votre compte Claude.ai. Les requetes tapent votre quota Pro.
#
# Les cles ci-dessous sont utiles pour permettre au Hunter de chercher sur le web.

# RECOMMANDE - sans ces cles le Hunter est limite au knowledge pre-entraine
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=

# OPTIONNEL - uniquement si vous voulez facturer sur API Anthropic plutot que Pro
ANTHROPIC_API_KEY=

# OPTIONNEL - uniquement si vous ajoutez CCR plus tard pour router vers d'autres providers
OPENAI_API_KEY=
MOONSHOT_API_KEY=
GOOGLE_API_KEY=

# OPTIONNEL - modele par defaut pour le Chief. Accepte: sonnet, opus, haiku.
# Defaut: sonnet (economise quota Pro vs Opus par defaut sur ton compte).
ATELIER_MODEL=sonnet

# OPTIONNEL - outils entreprise
LINKEDIN_LI_AT=
CRUNCHBASE_KEY=
ATTIO_API_KEY=
SLACK_BOT_TOKEN=
CALENDLY_TOKEN=
